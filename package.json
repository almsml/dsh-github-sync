{
  "name": "dsh-github-sync",
  "version": "0.3.0",
  "description": "把 DSH 工作区自动同步到 GitHub：每轮对话结束后提交并推送代码与文件，同时把该工作区的对话记录导出成可读 Markdown，换设备拉取后能接着聊。",
  "type": "module",
  "main": "index.js",
  "icon": "icon.png",
  "files": [
    "index.js",
    "lib",
    "panel.html",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "sync",
    "git"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
